<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- Botones en la cotización -->
  <record id="view_sale_order_form_planning_buttons" model="ir.ui.view">
    <field name="name">sale.order.form.planning.buttons</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="priority">20</field>
    <field name="arch" type="xml">

      <xpath expr="//header" position="inside">
        <button name="action_schedule_services"
                string="📅 Programar Servicios"
                type="object"
                class="btn-primary"
                groups="sales_team.group_sale_salesman"/>
        <button name="action_create_pending_service_orders"
                string="Crear OS Pendientes"
                type="object"
                class="btn-warning"
                invisible="planning_pending_count == 0"
                groups="sales_team.group_sale_salesman"/>
      </xpath>

      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_view_planning_slots" type="object"
                class="oe_stat_button" icon="fa-calendar"
                invisible="planning_slot_count == 0">
          <field name="planning_slot_count" widget="statinfo" string="Programados"/>
        </button>
      </xpath>

    </field>
  </record>

</odoo>