<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- =========================================================
       PERMISOS DE EMPRESA
       ========================================================= -->
  <record id="view_company_permit_list" model="ir.ui.view">
    <field name="name">service.company.permit.list</field>
    <field name="model">service.company.permit</field>
    <field name="arch" type="xml">
      <list string="Permisos de Empresa"
            decoration-danger="state == 'expired'"
            decoration-warning="expiry_date and expiry_date &lt;= (current_date + datetime.timedelta(days=30))"
            decoration-success="state == 'active'">
        <field name="name"/>
        <field name="permit_type"/>
        <field name="number"/>
        <field name="scope"/>
        <field name="partner_id" optional="show"/>
        <field name="issue_date"/>
        <field name="expiry_date"/>
        <field name="state" widget="badge"
               decoration-success="state == 'active'"
               decoration-danger="state == 'expired'"
               decoration-info="state == 'draft'"/>
      </list>
    </field>
  </record>

  <record id="view_company_permit_form" model="ir.ui.view">
    <field name="name">service.company.permit.form</field>
    <field name="model">service.company.permit</field>
    <field name="arch" type="xml">
      <form string="Permiso de Empresa">
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="permit_type"/>
              <field name="number"/>
              <field name="scope"/>
            </group>
            <group>
              <field name="company_id" groups="base.group_multi_company"/>
              <field name="partner_id"/>
              <field name="issue_date"/>
              <field name="expiry_date"/>
              <field name="state"/>
            </group>
          </group>
          <group string="Documentos">
            <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
          </group>
          <group string="Notas">
            <field name="notes" nolabel="1"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_company_permit" model="ir.actions.act_window">
    <field name="name">Permisos de Empresa</field>
    <field name="res_model">service.company.permit</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- =========================================================
       AUTORIZACIONES DE CLIENTES
       ========================================================= -->
  <record id="view_client_authorization_list" model="ir.ui.view">
    <field name="name">service.client.authorization.list</field>
    <field name="model">service.client.authorization</field>
    <field name="arch" type="xml">
      <list string="Autorizaciones de Clientes"
            decoration-danger="state == 'expired'"
            decoration-success="state == 'active'">
        <field name="partner_id"/>
        <field name="name"/>
        <field name="authorization_type"/>
        <field name="number"/>
        <field name="issue_date"/>
        <field name="expiry_date"/>
        <field name="state" widget="badge"
               decoration-success="state == 'active'"
               decoration-danger="state == 'expired'"
               decoration-info="state == 'draft'"/>
      </list>
    </field>
  </record>

  <record id="view_client_authorization_form" model="ir.ui.view">
    <field name="name">service.client.authorization.form</field>
    <field name="model">service.client.authorization</field>
    <field name="arch" type="xml">
      <form string="Autorización de Cliente">
        <sheet>
          <group>
            <group>
              <field name="partner_id" options="{'no_create': True}"/>
              <field name="name"/>
              <field name="authorization_type"/>
              <field name="number"/>
            </group>
            <group>
              <field name="issue_date"/>
              <field name="expiry_date"/>
              <field name="state"/>
            </group>
          </group>
          <group string="Documentos">
            <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
          </group>
          <group string="Notas">
            <field name="notes" nolabel="1"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_client_authorization" model="ir.actions.act_window">
    <field name="name">Autorizaciones de Clientes</field>
    <field name="res_model">service.client.authorization</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- =========================================================
       PERMISOS DE VEHÍCULOS (Acción directa)
       ========================================================= -->
  <record id="action_vehicle_permits" model="ir.actions.act_window">
    <field name="name">Permisos de Vehículos</field>
    <field name="res_model">fleet.vehicle.permit</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="view_vehicle_permit_list" model="ir.ui.view">
    <field name="name">fleet.vehicle.permit.list</field>
    <field name="model">fleet.vehicle.permit</field>
    <field name="arch" type="xml">
      <list string="Permisos de Vehículos"
            decoration-danger="state == 'expired'"
            decoration-success="state == 'active'">
        <field name="vehicle_id"/>
        <field name="name"/>
        <field name="permit_type"/>
        <field name="number"/>
        <field name="holder_type"/>
        <field name="issuing_authority"/>
        <field name="issue_date"/>
        <field name="expiry_date"/>
        <field name="state" widget="badge"
               decoration-success="state == 'active'"
               decoration-danger="state == 'expired'"
               decoration-info="state == 'draft'"
               decoration-warning="state == 'renewed'"/>
      </list>
    </field>
  </record>

  <!-- =========================================================
       PERMISOS DE CHOFERES (Acción directa)
       ========================================================= -->
  <record id="action_driver_permits" model="ir.actions.act_window">
    <field name="name">Permisos de Choferes</field>
    <field name="res_model">fleet.driver.permit</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="view_driver_permit_list" model="ir.ui.view">
    <field name="name">fleet.driver.permit.list</field>
    <field name="model">fleet.driver.permit</field>
    <field name="arch" type="xml">
      <list string="Permisos de Choferes"
            decoration-danger="state == 'expired'"
            decoration-success="state == 'active'">
        <field name="driver_id"/>
        <field name="name"/>
        <field name="permit_type"/>
        <field name="number"/>
        <field name="issue_date"/>
        <field name="expiry_date"/>
        <field name="state" widget="badge"
               decoration-success="state == 'active'"
               decoration-danger="state == 'expired'"
               decoration-info="state == 'draft'"/>
      </list>
    </field>
  </record>

</odoo>
